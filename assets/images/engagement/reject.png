<svg width="400" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ef4444;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#dc2626;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background circle -->
  <circle cx="200" cy="200" r="180" fill="url(#grad2)" opacity="0.9"/>

  <!-- X mark circle -->
  <circle cx="200" cy="200" r="100" fill="none" stroke="white" stroke-width="12"/>

  <!-- X mark -->
  <line x1="160" y1="160" x2="240" y2="240" stroke="white" stroke-width="16" stroke-linecap="round"/>
  <line x1="240" y1="160" x2="160" y2="240" stroke="white" stroke-width="16" stroke-linecap="round"/>

  <!-- Label -->
  <text x="200" y="340" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="white" text-anchor="middle">REJECT</text>
</svg>
